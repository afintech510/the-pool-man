# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_PASSWORD=your-db-password
SUPABASE_ACCESS_TOKEN=your-cli-access-token

# Cal.com (F-006)
NEXT_PUBLIC_CALCOM_URL=https://cal.com/your-user/your-event
CALCOM_WEBHOOK_SECRET=

# Brevo (F-012)
BREVO_API_KEY=xkeysib-...
# From address for website mail. Uses a dedicated sending subdomain
# (sender.kevinthepoolman.com) authenticated in Brevo, isolated from the M365
# corporate mail on the root domain. Override only if the subdomain changes.
BREVO_SENDER_EMAIL=noreply@sender.kevinthepoolman.com
BREVO_SENDER_NAME=The Pool Man Website

# Shopify (F-016)
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_WEBHOOK_SECRET=

# Quo/Sona (F-009)
QUO_WEBHOOK_SECRET=

# Google Analytics 4 + Google Ads (gtag.js). Inlined at BUILD time — set these
# in the VPS build environment, then rebuild. Leave blank to disable tracking.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXXX

# Google Ads conversion labels — the per-action label from each conversion you
# create in Google Ads (format: "AbC-D_efG-h12_3-Xyz"). Paired with the
# NEXT_PUBLIC_GOOGLE_ADS_ID above to form the send_to target. Leave blank and
# the matching conversion simply doesn't fire.
NEXT_PUBLIC_ADS_LABEL_CONTACT=           # fires on successful contact-form submit
NEXT_PUBLIC_ADS_LABEL_BOOKING=           # fires when the booking page is reached (soft proxy)
NEXT_PUBLIC_ADS_LABEL_BOOKING_CONFIRMED= # fires when Cal.com confirms a booking (real conversion)
NEXT_PUBLIC_ADS_LABEL_CALL=              # fires on any tel: phone-link click site-wide

# Google Search Console — token from the "HTML tag" verification method.
# (Alternatively verify via DNS TXT at Cloudflare, which needs no code.)
GOOGLE_SITE_VERIFICATION=
